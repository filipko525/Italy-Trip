# Mapbox – povinné pre živú mapu. Bez tokenu appka zobrazí schematický fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase – voliteľné pre Etapu 1. Bez týchto hodnôt beží appka na lokálnom úložisku.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prihlásenie do appky (HTTP Basic Auth) – appka obsahuje citlivé osobné údaje
# (poistenie, doklady), preto je za jednoduchým zámkom. Bez nastavenia oboch
# hodnôt appka beží bez hesla (napr. pri lokálnom vývoji).
SITE_USER=
SITE_PASSWORD=
